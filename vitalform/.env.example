# Optional cloud sync, PIP.EXE assistant, and affiliate configuration.
# Copy this file to .env.local if you use an optional service.

# ==============================================================================
# 1. OPTIONAL SUPABASE CLOUD SYNC & CAREGIVER LINK
# ==============================================================================
# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Supabase Anon Public Key (safe for client-side use with Row Level Security)
VITE_SUPABASE_ANON_KEY=

# ==============================================================================
# 2. OPTIONAL PIP.EXE SERVER ASSISTANT
# ==============================================================================
# Keep the key server-side. Never use a VITE_ prefix for this value.
# With no key, PIP uses its local rules. Online site questions require opt-in.
PIP_ASSISTANT_API_KEY=
PIP_ASSISTANT_MODEL=gpt-4o-mini

# ==============================================================================
# 3. OPTIONAL STORE AFFILIATE TAGS (Monetization & Product Links)
# ==============================================================================
# Amazon Associates tracking tag (e.g. yourtag-21)
VITE_AFFILIATE_AMAZON_TAG=

# Flipkart Affiliate ID (affid)
VITE_AFFILIATE_FLIPKART_AFFID=

# Nykaa / 1mg / PharmEasy affiliate or partner tracking tags
VITE_AFFILIATE_NYKAA_TAG=
VITE_AFFILIATE_1MG_TAG=
VITE_AFFILIATE_PHARMEASY_TAG=

# Note: If all keys are left empty, AURA-CARE operates in 100% Local-First mode
# with zero external server dependencies, full offline PWA resilience, and instant response!
