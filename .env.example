# AURA-CARE Optional Cloud Sync, Clinical AI Coach & Affiliate Configuration
# Copy this file to .env.local to enable optional cloud sync, external LLM coach, or affiliate tags:

# ==============================================================================
# 1. OPTIONAL SUPABASE CLOUD SYNC & CAREGIVER LINK
# ==============================================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ==============================================================================
# 2. OPTIONAL AURA AI COACH LLM ENDPOINT (OpenAI / OpenRouter / Groq / Ollama)
# ==============================================================================
VITE_OPENAI_API_KEY=
VITE_OPENAI_BASE_URL=https://api.openai.com/v1
VITE_COACH_MODEL=gpt-4o-mini

# ==============================================================================
# 3. OPTIONAL STORE AFFILIATE TAGS (Monetization & Product Links)
# ==============================================================================
VITE_AFFILIATE_AMAZON_TAG=
VITE_AFFILIATE_FLIPKART_AFFID=
VITE_AFFILIATE_NYKAA_TAG=
VITE_AFFILIATE_1MG_TAG=
VITE_AFFILIATE_PHARMEASY_TAG=

# Note: If all keys are left empty, AURA-CARE operates in 100% Local-First mode
# with zero external server dependencies, full offline PWA resilience, and instant response!
